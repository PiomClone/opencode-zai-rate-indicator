{
  "name": "opencode-zai-rate-indicator",
  "version": "0.2.4",
  "description": "OpenCode TUI plugin that shows current Z.AI peak quota status.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/PiomClone/opencode-zai-rate-indicator#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/PiomClone/opencode-zai-rate-indicator.git"
  },
  "bugs": {
    "url": "https://github.com/PiomClone/opencode-zai-rate-indicator/issues"
  },
  "oc-plugin": [
    "tui"
  ],
  "exports": {
    ".": "./src/tui.js",
    "./tui": "./src/tui.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "zai",
    "z-ai",
    "glm",
    "glm-5",
    "zai-coding-plan",
    "quota",
    "tui",
    "peak-pricing",
    "quota-indicator"
  ],
  "scripts": {
    "check": "node --check src/server.js && node --check src/tui.js"
  },
  "peerDependencies": {
    "@opentui/solid": "*"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    }
  }
}
